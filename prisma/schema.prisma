generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ORGANIZATIONS AND MEMBERSHIPS (tech spec §4, §5; decisions 008, 009) ───
// Tenant-owned parents declare @@unique([organizationId, id]) so children can
// reference them with a composite foreign key: a child row can never point at
// another organization's parent.

model Organization {
  id            String   @id @default(cuid())
  /// Normalized 11-digit organization national ID (شناسه ملی). A string: leading zeros matter.
  nationalId    String   @unique @db.VarChar(11)
  name          String
  isActive      Boolean  @default(true)
  /// Audio and transcript retention in whole days from acceptance (pilot 10, tech spec §10).
  retentionDays Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id                       String    @id @default(cuid())
  organizationId           String
  /// Normalized `09…` mobile; unique per organization, not globally.
  mobile                   String    @db.VarChar(11)
  /// Argon2id PHC string. Holds the initial password's hash until the member replaces it.
  passwordHash             String
  mustChangePassword       Boolean   @default(true)
  initialPasswordExpiresAt DateTime?
  passwordChangedAt        DateTime?
  activatedAt              DateTime  @default(now())
  revokedAt                DateTime?
  lastSignInAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     MemberSession[]

  @@unique([organizationId, mobile])
  @@unique([organizationId, id])
  @@map("memberships")
}

model MemberSession {
  id                String   @id @default(cuid())
  organizationId    String
  membershipId      String
  /// SHA-256 hex of the raw cookie token. The raw token is never persisted.
  tokenHash         String   @unique
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@index([absoluteExpiresAt])
  @@map("member_sessions")
}

enum RateLimitScope {
  ACCOUNT
  SOURCE
}

/// Failed sign-in counters (decision 008). Survives restarts and replicas; rows expire.
model AuthRateLimit {
  /// SHA-256 of scope + identifier, so no national ID, mobile or address is stored here.
  key           String         @id
  scope         RateLimitScope
  failures      Int
  windowStart   DateTime
  lastFailureAt DateTime
  expiresAt     DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

/// Operator CLI actions. Holds identifiers and structured detail only, never secrets.
/// No foreign keys: the record outlives a deleted organization.
model OperatorAudit {
  id             String   @id @default(cuid())
  operator       String
  action         String
  organizationId String?
  membershipId   String?
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("operator_audit")
}
