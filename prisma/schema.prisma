generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ORGANIZATIONS AND MEMBERSHIPS (tech spec §4, §5; decisions 008, 009) ───
// Tenant-owned parents declare @@unique([organizationId, id]) so children can
// reference them with a composite foreign key: a child row can never point at
// another organization's parent.

model Organization {
  id            String   @id @default(cuid())
  /// Normalized 11-digit organization national ID (شناسه ملی). A string: leading zeros matter.
  nationalId    String   @unique @db.VarChar(11)
  name          String
  isActive      Boolean  @default(true)
  /// Audio and transcript retention in whole days from acceptance (pilot 10, tech spec §10).
  retentionDays Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  calls       Call[]
  categories  IssueCategory[]

  @@map("organizations")
}

model Membership {
  id                       String    @id @default(cuid())
  organizationId           String
  /// Normalized `09…` mobile; unique per organization, not globally.
  mobile                   String    @db.VarChar(11)
  /// Argon2id PHC string. Holds the initial password's hash until the member replaces it.
  passwordHash             String
  mustChangePassword       Boolean   @default(true)
  initialPasswordExpiresAt DateTime?
  passwordChangedAt        DateTime?
  activatedAt              DateTime  @default(now())
  revokedAt                DateTime?
  lastSignInAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     MemberSession[]
  accessLogs   AccessLog[]

  @@unique([organizationId, mobile])
  @@unique([organizationId, id])
  @@map("memberships")
}

model MemberSession {
  id                String   @id @default(cuid())
  organizationId    String
  membershipId      String
  /// SHA-256 hex of the raw cookie token. The raw token is never persisted.
  tokenHash         String   @unique
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@index([absoluteExpiresAt])
  @@map("member_sessions")
}

enum RateLimitScope {
  ACCOUNT
  SOURCE
}

/// Failed sign-in counters (decision 008). Survives restarts and replicas; rows expire.
model AuthRateLimit {
  /// SHA-256 of scope + identifier, so no national ID, mobile or address is stored here.
  key           String         @id
  scope         RateLimitScope
  failures      Int
  windowStart   DateTime
  lastFailureAt DateTime
  expiresAt     DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

/// Operator CLI actions. Holds identifiers and structured detail only, never secrets.
/// No foreign keys: the record outlives a deleted organization.
model OperatorAudit {
  id             String   @id @default(cuid())
  operator       String
  action         String
  organizationId String?
  membershipId   String?
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("operator_audit")
}

// ─── CALLS, RECORDINGS AND THE QUEUE (tech spec §5, §6, §7; decision 010) ───
// Children of Call reference it through (organizationId, callId), so the
// database rejects a row that points at another organization's call.

enum CallState {
  /// Bytes reserved, object not yet committed. Internal; never claimed by a job.
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum DateSource {
  FILENAME
  UPLOAD
}

enum RecordingState {
  PENDING
  STORED
  /// Past retention: hidden at once; the deletion task removes the object.
  EXPIRED
  DELETED
}

enum JobOperation {
  ANALYZE
}

enum JobTrigger {
  INITIAL
  RETRY
  REPROCESS
}

enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AccessAction {
  AUDIO_PLAYBACK
  TRANSCRIPT_VIEW
}

model Call {
  id               String     @id @default(cuid())
  organizationId   String
  acceptedAt       DateTime
  filenameDate     DateTime?  @db.Date
  effectiveDate    DateTime   @db.Date
  dateSource       DateSource
  /// Restricted metadata: may contain a caller's number. Shown and searched only inside the
  /// owning organization; never written to logs, object keys or telemetry. Kept after expiry.
  originalFilename String
  state            CallState  @default(UPLOADING)
  /// Stable code of the last failure (no_usable_speech, invalid_output, …).
  failureCode      String?
  /// Whether تلاش دوباره is offered (recoverable failure, recording still retained).
  failureRetryable Boolean    @default(false)
  rowVersion       Int        @default(0)
  activeRevisionId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recording      Recording?
  fingerprint    RecordingFingerprint?
  jobs           ProcessingJob[]
  accessLogs     AccessLog[]
  activeRevision AnalysisRevision?     @relation("ActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions      AnalysisRevision[]
  transcripts    Transcript[]
  findings       IssueFinding[]
  corrections    CorrectionAudit[]

  @@unique([organizationId, id])
  @@index([organizationId, effectiveDate(sort: Desc), id(sort: Desc)])
  @@index([organizationId, state])
  @@index([state, createdAt])
  @@map("calls")
}

model Recording {
  id             String         @id @default(cuid())
  organizationId String
  callId         String
  /// Generated: organizationId/callId/original.mp3. Never derived from the filename.
  objectKey      String         @unique
  bytes          Int
  durationMs     Int
  contentType    String
  expiresAt      DateTime
  state          RecordingState @default(PENDING)
  storedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  call Call @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, callId])
  @@index([state, expiresAt])
  @@map("recordings")
}

/// Exact-duplicate detection per organization. Deleted when the recording expires, so a
/// re-upload of an expired file creates a new call.
model RecordingFingerprint {
  organizationId String
  sha256         String   @db.Char(64)
  callId         String
  createdAt      DateTime @default(now())

  call Call @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, sha256])
  @@unique([organizationId, callId])
  @@map("recording_fingerprints")
}

/// Durable queue (decision 010). A partial unique index (hand-written in the migration) allows
/// only one QUEUED or RUNNING job per call and operation.
model ProcessingJob {
  id             String       @id @default(cuid())
  organizationId String
  callId         String
  operation      JobOperation @default(ANALYZE)
  trigger        JobTrigger   @default(INITIAL)
  state          JobState     @default(QUEUED)
  attempt        Int          @default(0)
  maxAttempts    Int
  runAfter       DateTime
  leaseToken     String?
  leaseExpiresAt DateTime?
  /// Pipeline stage for the UI (transcribing, analyzing).
  stage          String?
  errorCode      String?
  enqueuedAt     DateTime
  startedAt      DateTime?
  completedAt    DateTime?

  call Call @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)

  @@index([state, runAfter])
  @@index([state, leaseExpiresAt])
  @@index([organizationId, callId])
  @@map("processing_jobs")
}

/// One row per playback session and transcript view (tech spec §4). Kept with the call record.
model AccessLog {
  id             String       @id @default(cuid())
  organizationId String
  callId         String
  membershipId   String
  action         AccessAction
  createdAt      DateTime     @default(now())

  call       Call       @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, callId, createdAt])
  @@map("access_logs")
}

/// Project-wide storage budget (tech spec §10): the Supabase allowance is per project, so all
/// organizations share one row (id = 1). Reservation is one conditional UPDATE.
model StorageLedger {
  id             Int      @id @default(1)
  committedBytes BigInt   @default(0)
  reservedBytes  BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  @@map("storage_ledger")
}

// ─── ANALYSIS: TRANSCRIPTS, REVISIONS, FINDINGS, SCORES (tech spec §5, §8, §9) ───
// A published revision is never edited: corrections and reprocessing add a child
// revision. Composite tenant FKs where every column is required; the nullable
// links (active revision, finding category) also get hand-written composite FKs
// in the migration.

enum RevisionReason {
  INITIAL
  RETRY
  REPROCESS
  CORRECTION
}

enum RevisionStatus {
  PUBLISHED
  /// Reprocessing result held back because the active revision has human-set fields.
  CANDIDATE
  DISCARDED
}

enum Speaker {
  AGENT
  CUSTOMER
  UNKNOWN
}

enum IssueOutcome {
  RESOLVED
  UNRESOLVED
  UNKNOWN
}

enum ScoreCriterion {
  UNDERSTANDING
  CORRECT_ACTION
  CLEAR_CLOSURE
}

enum ScoreRating {
  MET
  PARTLY_MET
  NOT_MET
  INSUFFICIENT_EVIDENCE
}

enum EvidenceTarget {
  REASON
  ISSUE
  OUTCOME
  SCORE
}

/// One transcription of a call's audio. Reused by a retry only for the same model version.
/// Segments are deleted at expiry; the row stays as provenance.
model Transcript {
  id             String    @id @default(cuid())
  organizationId String
  callId         String
  modelVersion   String
  /// Set when the segments were deleted at retention expiry.
  expiredAt      DateTime?
  createdAt      DateTime  @default(now())

  call      Call                @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)
  segments  TranscriptSegment[]
  revisions AnalysisRevision[]

  @@unique([organizationId, id])
  @@index([organizationId, callId])
  @@map("transcripts")
}

model TranscriptSegment {
  id             String  @id @default(cuid())
  organizationId String
  transcriptId   String
  index          Int
  startMs        Int
  endMs          Int
  speaker        Speaker
  /// Persian transcript text. Restricted; never logged.
  text           String

  transcript Transcript @relation(fields: [organizationId, transcriptId], references: [organizationId, id], onDelete: Cascade)
  evidence   Evidence[]

  @@unique([transcriptId, index])
  @@unique([organizationId, id])
  @@map("transcript_segments")
}

model AnalysisRevision {
  id                     String         @id @default(cuid())
  organizationId         String
  callId                 String
  version                Int
  reason                 RevisionReason
  status                 RevisionStatus @default(PUBLISHED)
  parentRevisionId       String?
  transcriptId           String?
  outputSchemaVersion    String
  transcriberModel       String
  analyzerModel          String
  promptVersion          String
  rubricVersion          String
  taxonomyVersion        String
  /// دلیل تماس — model-written text, deleted at expiry.
  callReason             String?
  callReasonHumanSet     Boolean        @default(false)
  /// Optional review (تأیید بازبینی); separate from processing state.
  reviewedAt             DateTime?
  reviewedByMembershipId String?
  /// Member who saved a correction revision.
  createdByMembershipId  String?
  createdAt              DateTime       @default(now())

  call          Call               @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)
  transcript    Transcript?        @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  parent        AnalysisRevision?  @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  children      AnalysisRevision[] @relation("RevisionParent")
  activeForCall Call?              @relation("ActiveRevision")
  findings      IssueFinding[]
  scores        Score[]
  evidence      Evidence[]

  @@unique([callId, version])
  @@unique([organizationId, id])
  @@unique([organizationId, id, callId])
  @@map("analysis_revisions")
}

/// Versioned, tenant-scoped issue categories with stable IDs (tech spec §8).
model IssueCategory {
  id              String   @id @default(cuid())
  organizationId  String
  /// Stable machine key from the taxonomy (e.g. otp_not_received).
  key             String
  label           String
  description     String?
  taxonomyVersion String
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings     IssueFinding[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@map("issue_categories")
}

model IssueFinding {
  id                 String       @id @default(cuid())
  organizationId     String
  revisionId         String
  /// Denormalized for the report and drill-down; always the revision's call.
  callId             String
  position           Int
  categoryId         String?
  /// مشکل as the model described it — deleted at expiry.
  summary            String?
  outcome            IssueOutcome
  /// Short outcome explanation — deleted at expiry.
  outcomeExplanation String?
  /// Fixed at publish: ≥ 1 validated evidence segment and a mapped category (tech spec §9).
  /// Never recomputed, so expiry cannot change historical counts.
  eligible           Boolean
  /// At least one validated evidence segment at publish. Kept after expiry deletes the
  /// evidence rows, so a later category correction can still decide eligibility.
  hasEvidence        Boolean      @default(false)
  categoryHumanSet   Boolean      @default(false)
  outcomeHumanSet    Boolean      @default(false)

  revision AnalysisRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Cascade)
  call     Call             @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)
  category IssueCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  evidence Evidence[]

  @@unique([revisionId, position])
  @@index([organizationId, categoryId, eligible])
  @@index([organizationId, callId])
  @@map("issue_findings")
}

model Score {
  id             String         @id @default(cuid())
  organizationId String
  revisionId     String
  criterion      ScoreCriterion
  rating         ScoreRating
  /// Short explanation — deleted at expiry.
  explanation    String?
  humanSet       Boolean        @default(false)

  revision AnalysisRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Cascade)
  evidence Evidence[]

  @@unique([revisionId, criterion])
  @@map("scores")
}

/// A validated reference from a finding, outcome, reason or score to a transcript segment.
/// Never a copied quote. Deleted with the segments at expiry.
model Evidence {
  id             String         @id @default(cuid())
  organizationId String
  revisionId     String
  target         EvidenceTarget
  findingId      String?
  scoreId        String?
  segmentId      String

  revision AnalysisRevision  @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Cascade)
  segment  TranscriptSegment @relation(fields: [organizationId, segmentId], references: [organizationId, id], onDelete: Cascade)
  finding  IssueFinding?     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  score    Score?            @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([findingId])
  @@index([scoreId])
  @@map("evidence")
}

/// Who changed what and when (tech spec §5). Structured values only, never transcript or explanation text.
model CorrectionAudit {
  id                String   @id @default(cuid())
  organizationId    String
  callId            String
  sourceRevisionId  String
  resultRevisionId  String
  actorMembershipId String
  /// e.g. finding[0].category, finding[1].outcome, score.CLEAR_CLOSURE, review.confirmed
  field             String
  previousValue     String?
  newValue          String?
  createdAt         DateTime @default(now())

  call Call @relation(fields: [organizationId, callId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, callId, createdAt])
  @@map("correction_audits")
}

/// Bytes served from storage per calendar month (tech spec §10 egress budget, plan M5-T5):
/// audio playback and worker fetches. Alerts at STORAGE_ALERT_RATIO of EGRESS_MONTHLY_BYTES.
model EgressUsage {
  /// YYYY-MM (UTC)
  month     String   @id
  bytes     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("egress_usage")
}
