# Copy to .env and adjust. Every variable here is validated at boot by
# src/lib/env-schema.ts; the defaults shown are the Phase 1 pilot values.

# ─── Process role ────────────────────────────────────────────────────────────
# web (Next.js) | worker (src/worker) | cli (operator commands). Picks the
# database URL below and which settings production requires.
# PROCESS_ROLE=web

# ─── Database ────────────────────────────────────────────────────────────────
# Local work: one URL for everything (docker compose `npm run db:up`, or any
# local PostgreSQL). Pool tuning goes in the query string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
# Deployed (tech spec §11): one least-privileged role per workload, through
# Supavisor session mode with TLS. Each overrides DATABASE_URL for its role.
# DATABASE_URL_WEB="postgresql://baztab_web:…@…pooler.supabase.com:5432/postgres?sslmode=verify-full&connection_limit=3"
# DATABASE_URL_WORKER="postgresql://baztab_worker:…@…pooler.supabase.com:5432/postgres?sslmode=verify-full&connection_limit=2"
# Release/operator only (prisma migrate deploy, npm run operator). Never give it to web or worker.
# DATABASE_URL_MIGRATE="postgresql://baztab_migrate:…@…:5432/postgres?sslmode=verify-full"
# "true" logs every Prisma query (development only)
PRISMA_LOG_QUERIES=false
# Integration tests (npm run test:integration) use a separate database.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test"
# E2E (npm run test:e2e) on its own database, so it never touches dev data.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_e2e"

# ─── Web and sessions (tech spec §4) ─────────────────────────────────────────
# Canonical origin; unsafe requests must carry it in Origin. Required in production.
APP_ORIGIN=http://localhost:3000
# PORT=3000
# REPORT_TIME_ZONE=Asia/Tehran
# SESSION_IDLE_HOURS=24
# SESSION_ABSOLUTE_DAYS=7
# INITIAL_PASSWORD_EXPIRY_DAYS=7
# LOGIN_ACCOUNT_MAX_FAILURES=5
# LOGIN_SOURCE_MAX_FAILURES=30
# LOGIN_WINDOW_MINUTES=15
# Reverse proxies in front of the app (Darkube ingress = 1); the client address
# is that many entries from the end of X-Forwarded-For.
# TRUSTED_PROXY_COUNT=1
# "true" serves a mock member so the UI runs without a database. Refused when NODE_ENV=production.
SKIP_AUTH=false

# ─── Upload and media (tech spec §6) ─────────────────────────────────────────
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_MAX_FILES=50
# UPLOAD_CONCURRENCY=2
# UPLOAD_TIMEOUT_SECONDS=120
# UPLOAD_SCRATCH_DIR=        (default: OS temp dir)
# UPLOAD_RESERVATION_TTL_MINUTES=30
# FILENAME_DATE_MIN=2020-01-01
# ffprobe binary (packaged in the web and worker images; on Windows use the full path)
# FFPROBE_PATH=ffprobe
# MEDIA_PROBE_TIMEOUT_MS=15000

# ─── Storage, retention and budget (tech spec §10) ───────────────────────────
# fs (local development, files under STORAGE_FS_ROOT) | s3 (Supabase S3; required in production)
STORAGE_DRIVER=fs
# STORAGE_FS_ROOT=.storage
# Supabase S3 access keys for the private bucket. Never the service-role or anon key.
# STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# STORAGE_REGION=<project region>
# STORAGE_BUCKET=recordings
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUDGET_BYTES=800000000
# STORAGE_ALERT_RATIO=0.7
# EGRESS_MONTHLY_BYTES=5000000000
# Audio/transcript retention for newly provisioned organizations, in days (pilot 10).
# RETENTION_DAYS=10

# ─── Worker and inference (tech spec §7, §8) ─────────────────────────────────
# WORKER_CONCURRENCY=1
# WORKER_LEASE_SECONDS=120
# WORKER_POLL_SECONDS=5
# WORKER_MAX_ATTEMPTS=3
# First retry delay for transient failures (×4 per attempt, capped at 30 min)
# WORKER_BACKOFF_BASE_SECONDS=30
# WORKER_SHUTDOWN_GRACE_SECONDS=30
# WORKER_MAINTENANCE_SECONDS=300
# WORKER_SCRATCH_DIR=        (default: OS temp dir)
# Liveness endpoint for the worker container (GET /health).
# WORKER_HEALTH_PORT=3100
# fake = deterministic synthetic transcripts and findings (development, tests,
# synthetic staging). The self-managed model adapter lands with M3-T8.
# INFERENCE_ENGINE=fake
# INFERENCE_ALLOW_FAKE_IN_PRODUCTION=false

# ─── Logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
