# syntax=docker/dockerfile:1.7
# baztab-worker (decision 010, 011): private analysis worker. No ingress; the
# optional health port is for the container probe only. Concurrency one.
# A real model (plan M3-T8) is added here as a pinned artifact once chosen (D2).

FROM node:26-bookworm-slim AS base
WORKDIR /app
ENV npm_config_fetch_retries=5 \
    PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
RUN apt-get -o Acquire::Check-Valid-Until=false update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

# ─── Builder: bundle src/worker and keep only production packages ─────────
FROM base AS builder
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --no-fund
COPY . .
RUN npx prisma generate \
    && npm run worker:build \
    && npm prune --omit=dev --no-audit --no-fund

# ─── Runner ───────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production \
    PROCESS_ROLE=worker \
    FFPROBE_PATH=/usr/bin/ffprobe \
    WORKER_SCRATCH_DIR=/tmp/baztab-worker \
    WORKER_HEALTH_PORT=3100

RUN apt-get -o Acquire::Check-Valid-Until=false update -y \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 worker \
    && mkdir -p /data/storage && chown worker:nodejs /data/storage

COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/dist/worker.mjs ./dist/worker.mjs
COPY --from=builder --chown=worker:nodejs /app/package.json ./package.json
COPY --from=builder --chown=worker:nodejs /app/prisma/supabase-ca.crt ./prisma/supabase-ca.crt

USER worker
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# `react-server` makes the `server-only` guard an empty module (plan A7).
CMD ["node", "--conditions=react-server", "dist/worker.mjs"]
